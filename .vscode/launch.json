{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "AuthServiceApplication",
      "request": "launch",
      "mainClass": "com.nonmus.AuthServiceApplication",
      "projectName": "auth-service"
    },
    {
      "type": "java",
      "name": "EmailServiceApplication",
      "request": "launch",
      "mainClass": "com.nonmus.EmailServiceApplication",
      "projectName": "email-service",
      "args": "",
      "envFile": "${workspaceFolder}/.vscode/.env"
    },
    {
      "type": "java",
      "name": "UserServiceApplication",
      "request": "launch",
      "mainClass": "com.nonmus.UserServiceApplication",
      "projectName": "user-service",
      "args": ""
    }
  ],
  "compounds": [
    {
      "name": "Run All Services",
      "configurations": [
        "EmailServiceApplication",
        "UserServiceApplication",
        "AuthServiceApplication"
      ]
    }
  ]
}
