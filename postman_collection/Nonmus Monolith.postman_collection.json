              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/profile-picture/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "profile-picture",
                "confirm"
              ]
            },
            "description": "Tells the backend which S3 key was uploaded. The backend:\n1. Validates the key belongs to you (prefix check)\n2. Deletes your old profile picture from S3\n3. Saves the new key to the database\n4. Returns a fresh presigned GET URL ready to use in `<img src>`\n\nThe `s3Key` variable is auto-populated from Step 1."
          },
          "response": [
            {
              "name": "Success (200)",
              "originalRequest": {
